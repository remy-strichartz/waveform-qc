# Raw / converted waveform data (hundreds of MB - GB; regenerate with
# file_manipulation/midas_to_h5.py + extract_channels.py / caen_to_h5.py)
waveform_files/

# Generated results trees (regenerate with each pipeline's driver; see
# energy_reconstruction/README.md for the production commands)
*_results/

# Python bytecode
__pycache__/
*.pyc

# PDF report renders: kept locally for the author, never published. The reports are
# regenerable and can be large; source lives in the code + *_results/ figures.
pdf_reports/
*.pdf

# Screenshots / scratch images dropped in the project root: they are scratch, not
# analysis, and one of them (example.png) contained a personal email address.
# Results plots live in *_results/ subfolders, so a root-only rule is safe.
/*.png

# Local editor state -- but NOT the two shared files.  Nothing here is installed as a
# package (the drivers run as scripts and add their siblings to sys.path at runtime), so
# without these an editor cannot resolve a single cross-package import and a fresh clone
# looks broken.  They hold relative paths only.
.vscode/*
!.vscode/settings.json
!.vscode/pyrightconfig.json
.idea/
